{
  "recipes": [
    {
      "id": "7fe6768ad086",
      "name": "反沙芋头",
      "category": "dessert",
      "categoryName": "甜品",
      "difficulty": 3,
      "ingredients": [
        "荔浦芋头（电商平台购买即可，实惠新鲜）",
        "白砂糖或冰糖",
        "水",
        "葱"
      ],
      "portions": [
        "荔浦芋头 200g",
        "白砂糖 30g",
        "水 15g"
      ],
      "steps": [
        {
          "step": 1,
          "description": "芋头切长条（稍微大条一点，翻炒过程不容易烂）"
        },
        {
          "step": 2,
          "description": "加入可以没过芋头的油，等油温起来（插入筷子冒小泡即可）"
        },
        {
          "step": 3,
          "description": "放进芋头到油里，去炸到芋头浮起来，一般是微微泛黄并且可以用筷子很轻松戳洞"
        },
        {
          "step": 4,
          "description": "炸芋头的油放起来别浪费，后面炒菜啥的都能用"
        },
        {
          "step": 5,
          "description": "接下来关键的一步，把糖(30g)和水(15g)按照 2：1 比例，加热至不变色且冒小泡"
        },
        {
          "step": 6,
          "description": "倒入葱花和芋头，关火翻炒，此时等温度下来，糖就会有反沙的效果"
        },
        {
          "step": 7,
          "description": "装盘上桌！"
        }
      ],
      "tips": [
        "刚做好的反沙芋头很烫，小心烫嘴哦"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "b6b656193fda",
      "name": "咖啡椰奶冻",
      "category": "dessert",
      "categoryName": "甜品",
      "difficulty": 4,
      "ingredients": [
        "125ml 淡奶油",
        "250ml 椰树牌椰汁",
        "35ml espresso 意式浓缩",
        "50ml 椰子水",
        "10g 吉利丁(gelatin)",
        "过滤网（可选）",
        "（那个...有摆盘需求的话，可以来点蓝莓 and/or 咖啡粉）"
      ],
      "portions": [
        "125ml 淡奶油(whipping cream, 35% M.E)",
        "250ml 椰树牌椰汁",
        "35ml espresso 意式浓缩（个人不推荐用 fruity 的咖啡豆）",
        "50ml 椰子水（推荐 vita coco coconut water，有条件可以敲一个椰子）",
        "10g 吉利丁",
        "糖（可选）"
      ],
      "steps": [
        {
          "step": 1,
          "description": "将定量淡奶油，椰树牌椰汁，espresso，椰子水混合备用。"
        },
        {
          "step": 2,
          "description": "将以上液体加热 1 分钟，温度达到 50-60 度即可。"
        },
        {
          "step": 3,
          "description": "（可选）如果格外嗜甜可以加额外的糖。"
        },
        {
          "step": 4,
          "description": "倒入吉利丁，搅拌至融化，煮 1 分钟。"
        },
        {
          "step": 5,
          "description": "（可选）过筛 （这一步可以让椰奶冻口感更佳顺畅）。"
        },
        {
          "step": 6,
          "description": "放入模具。"
        },
        {
          "step": 7,
          "description": "（可选）过滤掉表层的泡泡。这一步可以让椰奶冻口感更好，并且看着也会更棒。"
        },
        {
          "step": 8,
          "description": "放入冰箱冷藏区，等待 3 小时。"
        }
      ],
      "tips": [],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "3807029cc11b",
      "name": "奥利奥冰淇淋",
      "category": "dessert",
      "categoryName": "甜品",
      "difficulty": 3,
      "ingredients": [
        "淡奶油（推荐品牌 安佳动物淡奶油）",
        "原味奥利奥",
        "电动打蛋器",
        "一个容量在 600 毫升以上且直径小（PS: 需要注意能放得下电动打蛋仪）深度深的容器（如准备了冰淇淋模具 容器需要有尖嘴方便转移）",
        "小刀（或者可以去除夹心的工具）",
        "冰淇淋模具（可选）"
      ],
      "portions": [
        "奥利奥 6 块",
        "白砂糖 18 克",
        "淡奶油 250 毫升"
      ],
      "steps": [
        {
          "step": 1,
          "description": "将奥利奥拧开后去除利利（夹心），备用"
        },
        {
          "step": 2,
          "description": "用筷子将奥奥剁碎，需要有一半奥奥变成粉状，另一半的奥奥最大长度小于 0.5 厘米，备用（某宝可搜“奥利奥饼干碎”，节省时间精力^-^）"
        },
        {
          "step": 3,
          "description": "将奶油全部倒置于深容器中，并加入准备好的糖"
        },
        {
          "step": 4,
          "description": "开始用电动打蛋器高速挡 搅打至 电动打蛋器提起后下方会出现**悬挂住**的奶油（ 0.5 厘米 - 1 厘米），而不是**全部**像液体一样滴下（部分滴下是正常现象）。"
        },
        {
          "step": 5,
          "description": "搅打完成后将奥奥放入奶油中，搅拌均匀直至底部有奥奥。"
        },
        {
          "step": 6,
          "description": "可选：将混合物倒入冰淇淋模具中"
        },
        {
          "step": 7,
          "description": "放置冰箱冷冻室（ -18 度） 4 小时以上可取出"
        }
      ],
      "tips": [
        "剁碎奥利奥的容器注意不要使用易碎容器。",
        "去除奥利奥夹心时切忌注意割到手。"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "6b77b970a9b8",
      "name": "戚风蛋糕",
      "category": "dessert",
      "categoryName": "甜品",
      "difficulty": 5,
      "ingredients": [
        "烤箱（电饭锅可替代，但大多情况下由于锅胆材质问题易失败）",
        "打蛋器（电动最好，手动费力且有一定失败概率）或筷子（非常不推荐）",
        "铝合金阳极模具（千万不能选不沾模具，常用尺寸为 6 寸或 8 寸）",
        "刮刀（用于翻拌蛋糕糊） ### 原料",
        "鸡蛋",
        "白糖",
        "牛奶（或水）",
        "食用油（或黄油，但需加热软化）",
        "低筋面粉（推荐惠宜）",
        "[可选] 柠檬汁或白醋"
      ],
      "portions": [
        "1 个鸡蛋（正常中等大小，约 50g）",
        "白糖 16g",
        "食用油 8g",
        "牛奶 10g",
        "低筋面粉 17g 具体来说，对于常见 6 寸及 8 寸蛋糕：",
        "6 寸：大小为 3 份（即三个鸡蛋）。面积 36 个单位。",
        "鸡蛋 3 个，白糖 50g，食用油 25g，牛奶 30g，低筋面粉 50g",
        "8 寸：大小为 5 份（即五个鸡蛋）。面积 64 个单位。",
        "鸡蛋 5 个，白糖 80g，食用油 40g，牛奶 50g，低筋面粉 90g"
      ],
      "steps": [
        {
          "step": 1,
          "description": "从冰箱中取出新鲜的鸡蛋"
        },
        {
          "step": 2,
          "description": "准备两个容器并擦干，分别盛放蛋清与蛋黄"
        },
        {
          "step": 3,
          "description": "对盛放蛋清的容器，可稍有水珠，但**不能有任何油**；盛放蛋黄的容器不能有水珠"
        },
        {
          "step": 4,
          "description": "打蛋，手工或利用分蛋器，将蛋清与蛋黄分离到两个容器中。"
        },
        {
          "step": 5,
          "description": "分离过程中蛋黄不能破碎，**蛋清中不能混有任何蛋黄**，否则会严重影响打发。（白色系带可进入蛋清，不影响）"
        },
        {
          "step": 6,
          "description": "（注意，不使用厨房机的情况下，盛放蛋清的容器也是打蛋的容器，为避免溢出，加入全部蛋清后不要超过容器的 **1/8**） ### 搅拌蛋黄液"
        },
        {
          "step": 7,
          "description": "准备一个新的空碗，加入全部食用油，然后放入低筋面粉搅拌"
        },
        {
          "step": 8,
          "description": "油会直接阻断面筋的形成"
        },
        {
          "step": 9,
          "description": "将蛋黄加入碗中，再加入牛奶以及 **1/4** 的白糖，用刮刀搅拌均匀"
        },
        {
          "step": 10,
          "description": "此时加入的牛奶虽然含水，但是不应形成面筋了。"
        },
        {
          "step": 11,
          "description": "准备好低筋面粉，一边慢慢撒入容器一边用刮刀“Z 字形搅拌”（之字形搅拌），即刮刀只能沿着刀刃的方向两侧或前后移动。**不可无序地逆时针或顺时针搅拌**"
        },
        {
          "step": 12,
          "description": "继续，加入全部面粉，仍使用上述搅拌方式，直到混合均匀、无干粉状态。（出现一些团块是正常现象，可继续搅拌使其分散）"
        },
        {
          "step": 13,
          "description": "静置，备用 ### 打发蛋白"
        },
        {
          "step": 14,
          "description": "准备好剩余 **3/4** 的白糖。分为三份，每份为总量的 **1/4**"
        },
        {
          "step": 15,
          "description": "蛋清中加入柠檬汁或白醋（可选）"
        },
        {
          "step": 16,
          "description": "打蛋器中速，打发蛋白至有*粗大气泡的状态*，加入**第一份白糖**"
        },
        {
          "step": 17,
          "description": "打蛋器高速，打发蛋白至*气泡较细腻的状态*，加入**第二份白糖**"
        },
        {
          "step": 18,
          "description": "打蛋器高速，打发蛋白至*“湿性发泡”*的状态（此时提起打蛋器头，有长长的弯曲尖角），加入**第三份白糖**"
        },
        {
          "step": 19,
          "description": "打蛋器中低速，打发蛋白至“干性发泡”的状态（提起打蛋器头，有短小直立的尖角；倒扣容器，蛋白可粘住容器不掉下来）"
        },
        {
          "step": 20,
          "description": "此时蛋白打发程度已符合要求"
        },
        {
          "step": 21,
          "description": "关于蛋白状态的判断可参考附件链接中的图片。）"
        },
        {
          "step": 22,
          "description": "打蛋器应尽量贴近容器底部，防止出现上面浮着的表层打发，底部仍然是液体的情况） ### 混合搅拌"
        },
        {
          "step": 23,
          "description": "简单搅拌几下蛋黄液"
        },
        {
          "step": 24,
          "description": "用刮刀取 **1/3** 的蛋白霜，加入到蛋黄糊中"
        },
        {
          "step": 25,
          "description": "采用“翻拌”的手法，此手法是为了避免消泡"
        },
        {
          "step": 26,
          "description": "翻拌手法是"
        },
        {
          "step": 27,
          "description": "先用右手拿刮刀从搅拌盆中心插入面糊底部"
        },
        {
          "step": 28,
          "description": "向 8 点钟方向刮去直到碰到盆壁，顺势舀起面糊提到空中，然后再移回盆中心将面糊放入盆内"
        },
        {
          "step": 29,
          "description": "左手握住搅拌盆从 9 点钟方向转到 7 点钟方向，刚好旋转了 60 度，就完成了一次循环"
        },
        {
          "step": 30,
          "description": "速度大约是 1 秒钟两下"
        },
        {
          "step": 31,
          "description": "此方法出自《小岛老师的蛋糕教室》。用接地气的话说就是，像炒菜一样翻炒。"
        },
        {
          "step": 32,
          "description": "将 **1/3** 的蛋白霜与蛋黄液的混合液倒入剩余 **2/3** 的蛋白霜中，继续翻拌均匀"
        },
        {
          "step": 33,
          "description": "将蛋糕糊倒入模具，震荡几下避免大气泡 ### 烘烤"
        },
        {
          "step": 34,
          "description": "烘烤总时间：6 寸蛋糕 **30-35** 分钟，8 寸蛋糕 **50** 分钟。根据自己烤箱特性灵活调整，一般不超过 ±5 分钟。（最后几分钟时可在烤箱前观察）"
        },
        {
          "step": 35,
          "description": "以**上管 **150** 摄氏度，下管 **160** 摄氏度**预热烘烤，约 10 分钟可到达预定温度。"
        },
        {
          "step": 36,
          "description": "预热完成后，将模具放入烤箱下层"
        },
        {
          "step": 37,
          "description": "选择**变温烘烤**，分为两个阶段。"
        },
        {
          "step": 38,
          "description": "第一阶段烤箱设定温度为：上管 **150** 摄氏度，下管 **160** 摄氏度；"
        },
        {
          "step": 39,
          "description": "烘烤总时长的前 **3/5** 为第一阶段烘烤"
        },
        {
          "step": 40,
          "description": "第二阶段温度为：上管 **160** 摄氏度，下管 **170** 摄氏度；"
        },
        {
          "step": 41,
          "description": "烘烤总时长的后 **2/5** 为第二阶段烘烤。直接调整烤箱温度即可切换。"
        },
        {
          "step": 42,
          "description": "烤好后，出炉"
        },
        {
          "step": 43,
          "description": "此操作可能会**烫手**，注意用毛巾辅助 ### 冷却与脱模"
        },
        {
          "step": 44,
          "description": "（可选） 将模具从高处落下，震出其中的热气"
        },
        {
          "step": 45,
          "description": "模具倒扣 10 分钟，使蛋糕冷却"
        },
        {
          "step": 46,
          "description": "没有冷却的蛋糕立刻脱模会损伤蛋糕"
        },
        {
          "step": 47,
          "description": "此操作可能会**烫手**，注意用毛巾辅助"
        },
        {
          "step": 48,
          "description": "脱模，食用"
        }
      ],
      "tips": [
        "参考了以下教程，文中说明非常详细且有每一步骤的配图。同时，对于为什么做某一个操作、背后的原理也有阐释，以及出现某些问题的分析：",
        "[为了做好这个戚风蛋糕，用了一整箱鸡蛋，从此告别凹底和塌陷](https://zhuanlan.zhihu.com/p/86865919)",
        "对戚风蛋糕而言，蛋清打发是次要问题，关键是**烤制时的温度和时间**。",
        "蛋清容器而言，可有水珠，蛋黄容器不能有。",
        "原因：油会影响蛋白的打发，蛋清 85%是水，稍有水珠并不影响打发。",
        "特别新鲜的鸡蛋蛋清会比较硬，应对硬蛋清 5 个鸡蛋配方的话加 15ml 水会帮助蛋清打发（1 个鸡蛋配方则是 3g 水）",
        "蛋清打发途中加的糖，实际也是先融于蛋清中的水里，成为糖浆溶液包裹在气泡外，对打发的气泡起保护作用。",
        "温度对糖融于水的速率以及溶解度影响较大，刚从冰箱拿出的蛋清不易打发。但温度较低的鸡蛋容易分离蛋清蛋黄，建议分离后恢复室温再进行打发。"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
