    {
      "id": "313b0c294a07",
      "name": "微波炉蒸蛋",
      "category": "breakfast",
      "categoryName": "早餐",
      "difficulty": 1,
      "ingredients": [
        "鸡蛋",
        "温水或高汤",
        "食盐",
        "生抽（可选）",
        "香油",
        "耐热碗",
        "保鲜膜或微波炉专用盖"
      ],
      "portions": [
        "鸡蛋 2 个（约 100g 蛋液）",
        "温水或高汤 100-120ml（蛋液体积的 1.0-1.2 倍）",
        "食盐 1g",
        "生抽 2ml（可选）",
        "香油 几滴（出锅用） 使用上述条件，计算出计划使用的原材料比例。"
      ],
      "steps": [
        {
          "step": 1,
          "description": "将鸡蛋打散，加入温水/高汤、盐、生抽，轻轻搅匀，尽量不要起泡。"
        },
        {
          "step": 2,
          "description": "将蛋液过筛倒入耐热碗中，表面若有气泡可用牙签轻戳。"
        },
        {
          "step": 3,
          "description": "覆盖保鲜膜并扎 8-10 个小孔，或使用微波炉专用盖（留缝隙）。"
        },
        {
          "step": 4,
          "description": "放入微波炉中加热："
        },
        {
          "step": 5,
          "description": "700W：1 分 30 秒 → 视情况再加热 20-30 秒至表面刚凝。"
        },
        {
          "step": 6,
          "description": "600W：约 1 分 40 秒–2 分 10 秒。"
        },
        {
          "step": 7,
          "description": "800W：约 1 分 10 秒–1 分 40 秒。"
        },
        {
          "step": 8,
          "description": "加热完成后取出静置 1 分钟，让余温使中心完全熟化。"
        },
        {
          "step": 9,
          "description": "淋上香油，撒葱花即可食用。 > 不同功率和容器会影响时间，建议第一次尝试时少量多次加热，找到适合自己设备的最佳时长。"
        }
      ],
      "tips": [
        "水温应在 40–50℃ ，不宜过热。",
        "蛋液与水比例控制在 1:1 至 1:1.2 之间口感最佳。",
        "覆盖保鲜膜并扎孔能防止表面爆开或出现蜂窝。",
        "过筛可显著提升细腻度。"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "7dd25656e159",
      "name": "微波炉蛋糕",
      "category": "breakfast",
      "categoryName": "早餐",
      "difficulty": 1,
      "ingredients": [
        "微波炉",
        "能放进微波炉的容器",
        "黄油",
        "面粉",
        "泡打粉（不加吃着像饼）",
        "鸡蛋"
      ],
      "portions": [
        "鸡蛋🥚 1 个",
        "面粉🍚 15g",
        "泡打粉🍚 2.5g",
        "白（红）糖🍬 10g",
        "盐🧂 1g （口味可选）",
        "咖啡粉☕",
        "巧克力🍫",
        "麦片🍿",
        "牛奶🥛",
        "坚果🥜",
        "饼干屑🍪",
        "香蕉🍌",
        "非黑暗料理🍆"
      ],
      "steps": [
        {
          "step": 1,
          "description": "加入以下食材，注意不要超过容器的 3/4"
        },
        {
          "step": 2,
          "description": "挖半个鸡蛋大的黄油放进容器, 在微波炉**加热 15 秒**至融化"
        },
        {
          "step": 3,
          "description": "将**巧克力/香蕉** 融化/搅碎成 **颗粒/糊状**"
        },
        {
          "step": 4,
          "description": "打入一个鸡蛋并打散搅和"
        },
        {
          "step": 5,
          "description": "15g 白（红）糖（甜党可以多加些） （见附 4）"
        },
        {
          "step": 6,
          "description": "加入 1g 盐 (**如果后续的口味食材含盐需自己斟酌**)"
        },
        {
          "step": 7,
          "description": "加入 2.5g 泡打粉"
        },
        {
          "step": 8,
          "description": "加入 15g 面粉（筋度没太大影响）"
        },
        {
          "step": 9,
          "description": "**加入任何喜欢的口味食材!**（坚果与饼干等干食材不是现在放）"
        },
        {
          "step": 10,
          "description": "搅和至看不见干粉的稠酸奶状"
        },
        {
          "step": 11,
          "description": "加入可选的干燥食材（不包括冲泡粉）在顶端"
        },
        {
          "step": 12,
          "description": "夸赞一下自己🥰"
        },
        {
          "step": 13,
          "description": "微波炉（高火）加热 **1分钟** （至蓬松蛋糕形态）"
        },
        {
          "step": 14,
          "description": "取出杯子（烫手啊啊啊啊↑）并拍朋友圈就可以吃了"
        }
      ],
      "tips": [
        "在夸赞自己之前的操作可以重复多遍做出更大的蛋糕",
        "泡打粉用来让蛋糕更蓬松 大多不含铝 几块钱一包 可以买了在家备着",
        "在 **加入任何喜欢的口味食材！** 这一步骤中 若加入**液体**（如牛奶） 请务必确保下一步可以搅和成**稠酸奶状** 建议少量多次加入以防止水分过量而导致成品湿瘪"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "14c26888fd27",
      "name": "意式香肠北非蛋",
      "category": "breakfast",
      "categoryName": "早餐",
      "difficulty": 3,
      "ingredients": [
        "意式猪肉香肠（去肠衣）、辣香肠 (Chorizo) 或切块的午餐肉",
        "百味来 (Barilla) 拿坡里意面酱 (Napoletana Sauce)",
        "鸡蛋",
        "甜椒（青椒或红椒皆可）",
        "洋葱",
        "橄榄油",
        "帕马森干酪（可选）",
        "新鲜欧芹（可选）",
        "干辣椒碎（可选）",
        "面包（推荐酸面团面包 Sourdough、恰巴塔 Ciabatta 或厚切吐司）",
        "宽口平底锅（带锅盖）"
      ],
      "portions": [
        "肉类（香肠/午餐肉）：100g - 150g",
        "百味来拿坡里意面酱：1 罐（400g，提供基本的番茄、洋葱和香草风味）",
        "鸡蛋：3 - 4 个",
        "甜椒：半个（切细丝）",
        "洋葱：半个（切小丁）",
        "橄榄油：10ml - 15ml（用于炒菜）"
      ],
      "steps": [
        {
          "step": 1,
          "description": "将意式猪肉香肠去肠衣备用；洋葱切小丁；甜椒切细丝。"
        },
        {
          "step": 2,
          "description": "在宽口平底锅中倒入 10ml - 15ml 橄榄油，中火加热。"
        },
        {
          "step": 3,
          "description": "放入处理好的香肠或午餐肉，翻炒至边缘金黄酥脆（如果使用生香肠，翻炒时用勺子将其捣碎变色）。"
        },
        {
          "step": 4,
          "description": "将洋葱丁和甜椒丝加入锅中与肉一起翻炒，持续翻炒 4 - 5 分钟，直到蔬菜变软，洋葱呈半透明状。"
        },
        {
          "step": 5,
          "description": "倒入百味来拿坡里意面酱，搅拌均匀。将火调至中低火，保持微沸炖煮 2 - 3 分钟。（如果酱汁看起来太稠，可以加入 15ml 水）。"
        },
        {
          "step": 6,
          "description": "用勺子的背面在锅内的酱汁中挖出 3 - 4 个小“坑”。"
        },
        {
          "step": 7,
          "description": "依次小心地将鸡蛋打入每个坑中。"
        },
        {
          "step": 8,
          "description": "盖上平底锅的盖子，利用蒸汽焖熟蛋白。等待 3 - 5 分钟。**注意：请频繁检查状态**。当蛋白变得不透明且凝固，但轻轻摇晃平底锅时蛋黄仍能晃动（溏心状态）时即可结束这一步。"
        },
        {
          "step": 9,
          "description": "关火。根据个人喜好撒上磨碎的帕马森干酪、新鲜欧芹或干辣椒碎。"
        },
        {
          "step": 10,
          "description": "将平底锅直接端上桌，配以硬壳面包蘸取蛋黄与酱汁食用。"
        }
      ],
      "tips": [
        "**肉类选择建议：**",
        "**意式香肠**：最能体现正宗风味（推荐寻找配料中含有小茴香籽/Fennel seeds 的香肠）。",
        "**午餐肉**：带来咸香、怀旧的口感，并且表面能煎得微脆。"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "42942f90d784",
      "name": "手抓饼",
      "category": "breakfast",
      "categoryName": "早餐",
      "difficulty": 2,
      "ingredients": [
        "普通面粉",
        "开水",
        "冷水",
        "食用油",
        "盐",
        "鸡蛋",
        "生菜",
        "火腿",
        "芝士片 ---"
      ],
      "portions": [
        "面粉 200 克",
        "开水 100 毫升",
        "冷水 50 毫升",
        "食用油 15 毫升",
        "盐 3 克",
        "鸡蛋 1 个",
        "生菜 30 克",
        "火腿 30 克",
        "芝士片 1 片 ---"
      ],
      "steps": [
        {
          "step": 1,
          "description": "面粉放入碗中，加入开水搅拌成絮状，再加入冷水揉成光滑面团，覆盖湿布静置 20 分钟。"
        },
        {
          "step": 2,
          "description": "面团分成每份约 100 克，搓圆，擀成薄片。"
        },
        {
          "step": 3,
          "description": "表面均匀涂抹食用油，撒上盐，卷成蜗牛状，松弛 10 分钟。"
        },
        {
          "step": 4,
          "description": "面团再次擀成薄饼，厚度均匀。"
        },
        {
          "step": 5,
          "description": "热锅中倒入油，小火煎至两面金黄起泡。"
        },
        {
          "step": 6,
          "description": "煎好的饼依次铺入煎蛋、生菜、火腿、芝士片等配料，卷起即可。 ---"
        }
      ],
      "tips": [
        "使用开水与冷水混合和面，有助于提升饼皮柔韧度。",
        "面团醒发时间不宜少于 20 分钟，否则不易擀薄。",
        "可根据个人口味增减配料，建议配料总重控制在 100 克以内。"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
