    {
      "id": "2fb69e4fcede",
      "name": "韩国麻药鸡蛋",
      "category": "breakfast",
      "categoryName": "早餐",
      "difficulty": 1,
      "ingredients": [
        "鸡蛋",
        "韩式酱油（或生抽）",
        "日式味淋",
        "白糖",
        "芝麻油",
        "青葱",
        "辣椒（小米辣或青红椒）"
      ],
      "portions": [
        "鸡蛋 5 - 8 个",
        "酱油（或生抽） 4 汤匙",
        "清水 4 汤匙",
        "味淋 2 汤匙",
        "白糖 2 汤匙",
        "芝麻油 5ml",
        "青葱 15g（切葱花）",
        "辣椒 15g（切圈）"
      ],
      "steps": [
        {
          "step": 1,
          "description": "烧一锅开水，水沸腾后放入鸡蛋，**煮 7 分钟**（得到完美的溏心蛋状态）。"
        },
        {
          "step": 2,
          "description": "煮鸡蛋的期间调制酱汁：将 4 汤匙酱油、4 汤匙清水、2 汤匙味淋、2 汤匙白糖倒入小锅中。"
        },
        {
          "step": 3,
          "description": "加热酱汁至沸腾，煮开以挥发掉味淋中的酒精味，随后关火放凉备用。"
        },
        {
          "step": 4,
          "description": "将切好的辣椒圈加入放凉的酱汁中。"
        },
        {
          "step": 5,
          "description": "将煮好的鸡蛋捞出，放入冰水中冷却后剥去蛋壳。"
        },
        {
          "step": 6,
          "description": "将剥好的鸡蛋放入调好的酱汁中，表面淋上 5ml 芝麻油并撒上葱花。"
        },
        {
          "step": 7,
          "description": "放入冰箱**冷藏等待 1 - 2 小时**，让鸡蛋充分入味。"
        }
      ],
      "tips": [
        "酱汁的比例可以根据个人口味微调。如果喜欢更甜，可以增加糖的用量。"
      ],
      "source": "HowToCook",
