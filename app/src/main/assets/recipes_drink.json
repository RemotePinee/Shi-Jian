    {
      "id": "1004a912226e",
      "name": "海边落日",
      "category": "drink",
      "categoryName": "饮品",
      "difficulty": 3,
      "ingredients": [
        "红石榴糖浆",
        "NFC 橙汁",
        "苏打水",
