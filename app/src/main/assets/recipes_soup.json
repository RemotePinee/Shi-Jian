      ],
      "portions": [
        "乳鸽 300 g",
        "菌菇 100 g",
        "玉米 200 g",
        "姜  30 g",
        "料酒 15 ml",
        "食用盐 10 g"
      ],
      "steps": [
        {
          "step": 1,
          "description": "冷水洗干净热心摊主处理好的乳鸽"
        },
        {
          "step": 2,
          "description": "冷水锅中放入洗干净的乳鸽，加入 15ml 料酒与姜，水煮开即可捞出乳鸽，要不然会丢失营养"
        },
        {
          "step": 3,
          "description": "把乳鸽放到高压缩或者瓦罐中、倒入的水要没过乳鸽，放入生姜 20 g，玉米 200 g、菌菇 100 g 注意：高压锅 30 分钟，瓦罐需在水烧开后转小火慢炖 40-60 分钟"
        },
        {
          "step": 4,
          "description": "时间到了，盛到碗中，加入 3~5g 盐 即可"
        }
      ],
      "tips": [],
      "source": "HowToCook",
      "imageUrl": "file:///android_asset/images/873754104ea5_菌菇炖乳鸽.jpg"
    },
    {
      "id": "27fccd5b3a0e",
      "name": "西红柿鸡蛋汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 2,
      "ingredients": [
        "西红柿",
        "鸡蛋",
        "香油",
        "味素",
        "盐",
        "葱、姜、蒜"
      ],
      "portions": [
        "西红柿 1 个",
        "鸡蛋 1-2 个（依照自己的口味而定，喜欢吃鸡蛋就放 2 个，一般就放 1 个）",
        "香油 2 滴",
        "味素 5 克（可选）",
        "盐 15 克",
        "葱、姜、蒜共 15 克"
      ],
      "steps": [
        {
          "step": 1,
          "description": "将西红柿洗净，切块。"
        },
        {
          "step": 2,
          "description": "葱姜蒜切碎。"
        },
        {
          "step": 3,
          "description": "鸡蛋打到碗中，用筷子（或打蛋器）搅拌均匀。"
        },
        {
          "step": 4,
          "description": "热锅，并放入 15 毫升的油，待能从油中看到冒出一丝烟时，放入葱姜蒜翻炒 30 秒。"
        },
        {
          "step": 5,
          "description": "放入西红柿翻炒 1 分钟。"
        },
        {
          "step": 6,
          "description": "倒入水，水的高度大约为锅内菜品高度的 1.2 倍，并放入盐。"
        },
        {
          "step": 7,
          "description": "待开锅后，将鸡蛋液放入，并用筷子将鸡蛋打散，放入味素和香油。"
        },
        {
          "step": 8,
          "description": "等待 30 秒，关火出锅。"
        }
      ],
      "tips": [],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "4fd6c239bf35",
      "name": "金针菇汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 2,
      "ingredients": [
        "金针菇",
        "鸡蛋（如需要）"
      ],
      "portions": [
        "金针菇 400-500 克 （市场里面售卖的一袋即可）",
        "食盐 15 克",
        "味精 5 克"
      ],
      "steps": [
        {
          "step": 1,
          "description": "金针菇徒手掰散，越散越好**不然容易藏牙**，洗净备用。"
        },
        {
          "step": 2,
          "description": "用菜刀或者水果刀将上述金针菇段段切，可依据个人喜好，但长度不宜超过 5 cm。"
        },
        {
          "step": 3,
          "description": "将金针菇放入锅中，加水没过约食材总高度 1.1 倍，沸腾后**等待 3 分钟**。"
        },
        {
          "step": 4,
          "description": "加入味精和食盐并搅拌。"
        },
        {
          "step": 5,
          "description": "继续加热约 30 秒，关火装盘。"
        }
      ],
      "tips": [
        "如果喜欢在汤里加入鸡蛋，可在步骤 3 中水沸腾之后将打散的鸡蛋液倒入锅中。"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "469de834220a",
      "name": "银耳莲子粥",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 4,
      "ingredients": [
        "银耳",
        "去心莲子",
        "红枣",
        "枸杞（可选）",
        "冰糖"
      ],
      "portions": [
        "银耳 60g",
        "去心莲子 20g",
        "红枣 6g",
        "枸杞 5-6g",
        "冰糖 10-20g"
      ],
      "steps": [
        {
          "step": 1,
          "description": "把银耳、莲子用清水浸泡 2 个小时，红枣浸泡 10 - 20 分钟，枸杞洗净，备用"
        },
        {
          "step": 2,
          "description": "在锅中倒入 600ml 水，烧开后依次放入银耳、莲子、红枣"
        },
        {
          "step": 3,
          "description": "等待水再次烧开后，盖上锅盖，转至中火继续熬"
        },
        {
          "step": 4,
          "description": "熬到大约 1 小时后，放入 5g - 10g 冰糖和 5g - 6g 枸杞，转至小火熬"
        },
        {
          "step": 5,
          "description": "小火继续熬 30 分钟，此时银耳开始呈现粘稠状态"
        },
        {
          "step": 6,
          "description": "再次放入 5g - 10g 冰糖，用勺子搅拌 5 - 10 分钟"
        },
        {
          "step": 7,
          "description": "关火，用勺子盛出"
        }
      ],
      "tips": [],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "0bb4b1f82d0d",
      "name": "陈皮排骨汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 3,
      "ingredients": [
        "排骨",
        "陈皮",
        "西洋参",
        "石斛",
        "玉竹",
        "麦冬",
        "煲汤盅",
        "盐"
      ],
      "portions": [
        "排骨，用猪骨也替代也可，4-5 块",
        "陈皮（一般选用 8-20 年制），一般 1 块陈皮是 3 瓣，取 1 瓣即可",
        "西洋参（又名花旗参），9 片",
        "石斛， 6 颗",
        "玉竹， 5 片",
        "麦冬， 7 个",
        "煲汤盅，按 1 人份",
        "食盐 ，5g"
      ],
      "steps": [
        {
          "step": 1,
          "description": "排骨用热水过一边，去血水"
        },
        {
          "step": 2,
          "description": "陈皮、麦冬、玉竹、石斛和西洋参，冲洗干净即可"
        },
        {
          "step": 3,
          "description": "煲汤盅洗干净 ### 操作"
        },
        {
          "step": 4,
          "description": "打开煲汤盅，先放入排骨在底部，然后依次放入陈皮、麦冬、玉竹、石斛和西洋参"
        },
        {
          "step": 5,
          "description": "加入热水进煲汤盅，水不宜太满"
        },
        {
          "step": 6,
          "description": "煲汤容器加入水，炖煮 1.5 小时即可"
        },
        {
          "step": 7,
          "description": "加入食盐，趁热饮用"
        }
      ],
      "tips": [],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "26673cfa3fba",
      "name": "黄瓜皮蛋汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 2,
      "ingredients": [
        "黄瓜",
        "皮蛋",
        "大蒜",
        "小葱",
        "食用油（推荐猪油）",
        "盐",
        "鸡精（可选）"
      ],
      "portions": [
        "黄瓜 1 根",
        "皮蛋 2 个",
        "大蒜 2 瓣",
        "小葱",
        "食用油 10-15 g",
        "盐 2-3 g",
        "鸡精 0.5-1 g",
        "水 400-500 ml"
      ],
      "steps": [
        {
          "step": 1,
          "description": "黄瓜洗净，切成 0.5-1.2 mm 厚的薄片"
        },
        {
          "step": 2,
          "description": "葱洗净切成末，蒜用刀拍几下去皮，对半切一下"
        },
        {
          "step": 3,
          "description": "皮蛋剥去壳，然后每个切成 6-8 份。锅里倒入油，放入切好的皮蛋和大蒜"
        },
        {
          "step": 4,
          "description": "小火炒至皮蛋和大蒜表面有些焦黄，加入水，转大火烧开"
        },
        {
          "step": 5,
          "description": "放入黄瓜片。水再次沸腾以后立马关火，放入盐、鸡精调味即可出锅"
        },
        {
          "step": 6,
          "description": "装入碗中，再撒上葱花即可"
        }
      ],
      "tips": [
        "黄瓜可以根据喜好决定是否去皮",
        "黄瓜薄片可以用刮皮刀刮",
        "皮蛋切块时抹点香油不容易粘刀"
      ],
      "source": "HowToCook",
      "imageUrl": null
    }
  ]
}