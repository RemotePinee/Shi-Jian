{
  "recipes": [
    {
      "id": "b0a7d4e6af99",
      "name": "勾芡香菇汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 3,
      "ingredients": [
        "香菇",
        "香葱",
        "食用油",
        "食用盐",
        "鸡精",
        "生粉"
      ],
      "portions": [
        "鲜香菇 2 朵",
        "香葱 0.5 根",
        "鸡精 3 g",
        "食用油 10 ml",
        "食用盐 3 g",
        "开水 350 ml",
        "生粉 10 g"
      ],
      "steps": [
        {
          "step": 1,
          "description": "香菇切片（每片厚度 0.5-1 cm,厚点相对薄点更有嚼劲），放入大碗中，倒入 2g 食用盐 浸泡 15 分钟"
        },
        {
          "step": 2,
          "description": "生粉倒入小碗中，加入 50ml 水，搅拌生粉直至融化没有颗粒（即水淀粉）"
        },
        {
          "step": 3,
          "description": "倒掉碗中的盐水，适当去掉香菇本身的水分（方便下一步煎炸）【可选】"
        },
        {
          "step": 4,
          "description": "小火，倒入油，待油开始冒小泡（小火 30s ，看每个锅的功率），倒入香菇，每面煎 10s 【可选】"
        },
        {
          "step": 5,
          "description": "倒入开水 300ml ，调中火再煮 3-5 分钟"
        },
        {
          "step": 6,
          "description": "倒入水淀粉，适当搅拌锅中汤汁后，加入 3g 盐、3 g ，最后撒上葱花出锅"
        }
      ],
      "tips": [],
      "source": "HowToCook",
      "imageUrl": "file:///android_asset/images/b0a7d4e6af99_1.jpeg"
    },
    {
      "id": "c9946e6c7528",
      "name": "奶油蘑菇汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 1,
      "ingredients": [
        "白蘑菇",
        "洋葱",
        "黄油",
        "面粉",
        "牛奶",
        "淡奶油",
        "黑胡椒碎",
        "盐",
        "清水 ---"
      ],
      "portions": [
        "白蘑菇 200 克",
        "洋葱 50 克",
        "黄油 15 克",
        "面粉 10 克",
        "牛奶 200 毫升",
        "淡奶油 30 毫升",
        "清水 100 毫升",
        "盐 2 克",
        "黑胡椒碎 1 克 ---"
      ],
      "steps": [
        {
          "step": 1,
          "description": "白蘑菇切片备用，洋葱切末备用。"
        },
        {
          "step": 2,
          "description": "平底锅中放入黄油，小火融化后加入洋葱炒至透明。"
        },
        {
          "step": 3,
          "description": "加入白蘑菇翻炒至出水变软，撒入面粉搅拌均匀。"
        },
        {
          "step": 4,
          "description": "加入牛奶和清水，搅拌均匀后小火煮沸，保持搅拌防止糊底。"
        },
        {
          "step": 5,
          "description": "转小火煮约 10 分钟，汤汁浓稠。"
        },
        {
          "step": 6,
          "description": "倒入淡奶油继续加热 1 分钟，加入盐和黑胡椒调味。"
        },
        {
          "step": 7,
          "description": "熄火后可用料理机打成细腻浓汤（可选）。 ---"
        }
      ],
      "tips": [
        "可将部分蘑菇预留作为装饰，提前煎香再添加。",
        "使用鸡高汤代替清水风味更佳，建议控制总液体不超过 300 毫升/份。",
        "喜欢浓汤口感可适当增加面粉和淡奶油用量。"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "da1b378cc2ad",
      "name": "小米粥",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 2,
      "ingredients": [
        "小米",
        "水（山泉水最佳）"
      ],
      "portions": [
        "小米 100 克",
        "水（山泉水最佳） 2000 克 使用上述条件，计算出计划使用的原材料比例。"
      ],
      "steps": [
        {
          "step": 1,
          "description": "小米 100 克，放入碗中，用水轻淘一遍（用手搅拌一下，将水倒掉，只是去掉外面的浮灰，不可搓洗！！！）"
        },
        {
          "step": 2,
          "description": "水烧开，务必烧开！！！"
        },
        {
          "step": 3,
          "description": "水烧开沸腾时，将小米倒入锅内。（很容易被忽视的一个很重要的环节）"
        },
        {
          "step": 4,
          "description": "搅拌使得小米不会粘连锅底，继续用大火熬 6-10 分钟，注意用中间穿插搅拌几次。"
        },
        {
          "step": 5,
          "description": "改中火、文火熬 15-20 分钟，锅盖要错开一条缝，千万不能让小米油溜掉哟，中间继续搅拌几次，不要糊锅底"
        }
      ],
      "tips": [
        "这是普通锅熬制（只需 30-35 分钟即可出锅）,味道最佳。高压锅和电饭锅省事，不过效果下降，水量要适当减少，一般 100 克小米+1800 克水",
        "小米只需用水去除浮灰，千万不可过分淘，会损失掉小米油的",
        "千万记住小米需要在水开的时候下锅"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "27a7ef0fbf94",
      "name": "排骨山药玉米汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 2,
      "ingredients": [
        "排骨（推荐精排）",
        "山药（推荐铁棍山药）",
        "胡萝卜",
        "玉米（推荐甜玉米或糯玉米）",
        "生姜",
        "小葱",
        "料酒",
        "食盐",
        "砂锅或深汤锅"
      ],
      "portions": [
        "排骨 500g",
        "山药 1 根（大约 300g）",
        "胡萝卜 1 根（大约 150g）",
        "玉米 1 根（大约 250g）",
        "生姜（大约 20g，切片备用）",
        "小葱（大约 15g，打结或切末备用）",
        "料酒 15ml",
        "食用油 10ml",
        "饮用水 1500ml - 2000ml",
        "食盐 6g - 8g"
      ],
      "steps": [
        {
          "step": 1,
          "description": "**食材预处理**："
        },
        {
          "step": 2,
          "description": "将胡萝卜洗净去皮，切成大约 3cm 的滚刀块。"
        },
        {
          "step": 3,
          "description": "玉米洗净，剁成大约 4cm 的圆柱状小块。"
        },
        {
          "step": 4,
          "description": "山药去皮（建议佩戴手套，防止粘液导致皮肤过敏），切成大约 4cm 的长段，备用。"
        },
        {
          "step": 5,
          "description": "**排骨焯水**："
        },
        {
          "step": 6,
          "description": "锅中加入足量冷水，放入洗净的排骨。"
        },
        {
          "step": 7,
          "description": "加入大约 10g 姜片、葱结和 15ml 料酒。"
        },
        {
          "step": 8,
          "description": "大火煮沸，沸腾后**等待 3 分钟**，期间用勺子撇去表面浮沫。"
        },
        {
          "step": 9,
          "description": "捞出排骨，用大约 40℃ 的温水洗净杂质，沥干备用。"
        },
        {
          "step": 10,
          "description": "**翻炒排骨**："
        },
        {
          "step": 11,
          "description": "热锅，倒入 10ml 食用油，等待 10 秒让油温升高。"
        },
        {
          "step": 12,
          "description": "放入剩余大约 10g 姜片爆香。"
        },
        {
          "step": 13,
          "description": "放入全部准备好的排骨，保持中火翻炒大约 1 分钟，至排骨表面微焦。"
        },
        {
          "step": 14,
          "description": "**炖煮过程**："
        },
        {
          "step": 15,
          "description": "在锅中一次性加入 1500ml - 2000ml 饮用水。"
        },
        {
          "step": 16,
          "description": "放入全部准备好的胡萝卜、玉米和山药。"
        },
        {
          "step": 17,
          "description": "大火烧开后转小火，盖上锅盖，**慢炖 40 分钟**。"
        },
        {
          "step": 18,
          "description": "**调味与出锅**："
        },
        {
          "step": 19,
          "description": "加入 6g - 8g 食盐，用勺子搅拌均匀。"
        },
        {
          "step": 20,
          "description": "保持小火继续**炖煮 2 分钟**使盐分入味。"
        },
        {
          "step": 21,
          "description": "关火，根据个人喜好撒入小葱末，盛盘。"
        }
      ],
      "tips": [
        "**防氧化技巧**：山药去皮后若不立即下锅，应浸泡在清水中，防止接触空气氧化变黑。",
        "**口感控制**：若喜欢山药极度软糯，可与排骨同时下锅；若喜欢山药成块不散，可在排骨炖煮 20 分钟后再放入山药。"
      ],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "d21b3190bf9e",
      "name": "排骨苦瓜汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 4,
      "ingredients": [
        "电压力锅（可以极大简化烹饪过程和时间）",
        "砂锅（相比于炒锅更适合炖汤） 必须材料",
        "排骨",
        "苦瓜",
        "虾皮"
      ],
      "portions": [
        "排骨  250g 到 500g",
        "苦瓜 100g 到 200g",
        "虾皮 5g 到 15g",
        "生姜 5~10g（可选，用于焯水时去腥）"
      ],
      "steps": [
        {
          "step": 1,
          "description": "排骨洗净，切到约 4cm ±2cm * 3 ± 2cm 的小块（如没有剁排骨的工具，可以求助摊主）"
        },
        {
          "step": 2,
          "description": "炒锅倒入冷水 700ml 和排骨一起加热至煮沸，关火捞出排骨"
        },
        {
          "step": 3,
          "description": "苦瓜中间切为两半，清除干净内部的种子和苦瓜瓤，切为 0.5 ± 0.3 cm 的苦瓜条，洗净 使用汤锅进行烹饪"
        },
        {
          "step": 4,
          "description": "汤锅倒入水 1100ml 和排骨，大火"
        },
        {
          "step": 5,
          "description": "等待水沸腾后将苦瓜和虾皮下锅转小火，放等待 120~240 分钟（在 120 分钟之后可以捞出一块肉进行品尝，若肉可以较为轻松的从骨头上分离即可关火）"
        },
        {
          "step": 6,
          "description": "出锅时加盐和白胡椒，推荐量为每 250ml 0.3 到 0.6g 盐，0.1 到 0.5g 白胡椒 使用电压力锅进行烹饪"
        },
        {
          "step": 7,
          "description": "倒入 1000ml 水和排骨，虾皮和苦瓜"
        },
        {
          "step": 8,
          "description": "选择炖汤功能，进行烹饪（一般为加压烹饪 45 分钟）"
        },
        {
          "step": 9,
          "description": "出锅，和汤锅一样进行加盐和胡椒"
        }
      ],
      "tips": [],
      "source": "HowToCook",
      "imageUrl": null
    },
    {
      "id": "8d549cb6a45d",
      "name": "昂刺鱼豆腐汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 3,
      "ingredients": [
        "昂刺鱼或者沙光鱼",
        "豆腐",
        "香葱",
        "姜",
        "食用油",
        "料酒",
        "食用盐",
        "胡椒粉"
      ],
      "portions": [
        "昂刺鱼或者沙光鱼 一条",
        "豆腐 100 g",
        "香葱 一根",
        "姜  一块",
        "胡椒粉 3-5 g",
        "食用油 15 ml",
        "食用盐 10-15 g",
        "开水 1L"
      ],
      "steps": [
        {
          "step": 1,
          "description": "鱼处理好后洗净，（特别注意肚内的血丝、不洗干净会有腥味），放入大碗中，倒入料酒、10g 姜片、5g 盐，腌制 15 分钟"
        },
        {
          "step": 2,
          "description": "豆腐切块，放入凉水浸泡 5 分钟，捞出备用"
        },
        {
          "step": 3,
          "description": "煎鱼前，先用生姜片擦一下锅防止粘锅，倒入油（油量为 15ml * 鱼的条数 ），烧热后放入鱼煎 2~3 分钟，期间需要晃动一下鱼，防止粘底，且需要翻一次身"
        },
        {
          "step": 4,
          "description": "待鱼全部煎好之后，倒入开水、5ml 料酒、姜片，小火转至大火，盖上锅盖、大火煮 10 分钟（水要稍微多一些，后面会蒸发掉一些）"
        },
        {
          "step": 5,
          "description": "见汤变白后倒入准备好的豆腐，调中火再煮 5 分钟，加入 10g 盐、3g 胡椒粉调味，最后撒上葱花出锅"
        }
      ],
      "tips": [],
      "source": "HowToCook",
      "imageUrl": "file:///android_asset/images/8d549cb6a45d_沙光鱼豆腐汤.jpg"
    },
    {
      "id": "a5abc2c8c888",
      "name": "朱雀汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 1,
      "ingredients": [
        "鸡蛋",
        "香油（芝麻油）",
        "白糖",
        "水"
      ],
      "portions": [
        "一个鸡蛋",
        "500ml 水",
        "20 克白糖（根据个人口味调整）",
        "2ml 香油"
      ],
      "steps": [
        {
          "step": 1,
          "description": "鸡蛋在碗中打散，再倒入香油。"
        },
        {
          "step": 2,
          "description": "水烧开后，在沸腾状态下快速倒入盛有鸡蛋的碗中。"
        },
        {
          "step": 3,
          "description": "放入白糖。"
        }
      ],
      "tips": [
        "鸡蛋一定要打散，水一定要在沸腾冒泡状态倒入鸡蛋液中，否则汤可能会浑浊影响口感",
        "此为豫东地区做法，其他地区有不放白糖放盐的，口味不同，根据个人口味调整"
      ],
      "source": "HowToCook",
      "imageUrl": "file:///android_asset/images/a5abc2c8c888_朱雀汤.jpg"
    },
    {
      "id": "70304304f6a9",
      "name": "玉米排骨汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 3,
      "ingredients": [
        "排骨",
        "玉米",
        "胡箩卜",
        "生姜",
        "大葱",
        "食用油",
        "醋",
        "料酒",
        "黑胡椒粉",
        "食用盐",
        "砂锅（没有的话，用铁锅也行）"
      ],
      "portions": [
        "排骨 500-800g",
        "玉米一根（喜欢吃玉米的可以多一根）",
        "胡萝卜一根（喜欢吃胡箩卜的可以多一根）",
        "大葱小半根",
        "香葱一根",
        "食用油 10 ml",
        "黑胡椒粉 4g",
        "料酒 10ml",
        "醋 10ml",
        "食用盐 10-15g（根据最后汤剩余的量而定）",
        "开水 1000 ml"
      ],
      "steps": [
        {
          "step": 1,
          "description": "大葱切成 3-4cm 的大段，用刀背拍一下"
        },
        {
          "step": 2,
          "description": "玉米剁成小块"
        },
        {
          "step": 3,
          "description": "胡箩卜切成滚刀块"
        },
        {
          "step": 4,
          "description": "生姜去皮切大片"
        },
        {
          "step": 5,
          "description": "新鲜的排骨砍成小块 ### 操作"
        },
        {
          "step": 6,
          "description": "排骨凉水下锅，放入大葱、生姜、料酒开始焯水，大火烧开，撇去浮沫，捞出排骨，沥干水分"
        },
        {
          "step": 7,
          "description": "热锅凉油，切大片的生姜和排骨一起下锅煸炒，待排骨表面微微焦黄，放入醋（可加速肉质软烂），继续煸炒一分钟"
        },
        {
          "step": 8,
          "description": "冲入开水，一次给足，之后就不要再加了，大火烧开"
        },
        {
          "step": 9,
          "description": "先下入玉米，放入胡椒粉，盖盖小火炖二十分钟，然后放入胡萝卜，盖盖继续小火炖四十分钟"
        },
        {
          "step": 10,
          "description": "调味很简单，出锅前三分钟，除了盐什么都不用放，最后撒上一把小葱花即可"
        }
      ],
      "tips": [],
      "source": "HowToCook",
      "imageUrl": "file:///android_asset/images/70304304f6a9_玉米排骨汤.jpeg"
    },
    {
      "id": "1b17e1a5e631",
      "name": "生汆丸子汤",
      "category": "soup",
      "categoryName": "汤与粥",
      "difficulty": 4,
      "ingredients": [
        "前腿肉",
        "盐",
        "胡椒粉",
        "葱姜花椒水",
        "一个鸡蛋的鸡蛋清",
        "土豆淀粉",
        "熟豆油 ### 丸子汤配料",
        "木耳",
        "黄花",
        "小香葱",
        "泡好的粉丝（放碗底）",
        "盐",
        "鸡粉",
        "胡椒粉",
        "香油",
        "香菜"
      ],
      "portions": [
        "盐量 = 猪肉斤数 * 6 克",
        "胡椒粉量 = 猪肉斤数 * 2 克",
        "土豆淀粉 = 多少人的用量 * 40 克，本教程以一人用量算"
      ],
      "steps": [
        {
          "step": 1,
          "description": "肉改刀切开，肥瘦三七分"
        },
        {
          "step": 2,
          "description": "上刀剁一剁，用刀背砸一砸，把肉筋打开打松疏"
        },
        {
          "step": 3,
          "description": "剁一剁，砸一砸，剁成肉末，要想好吃得自己剁，机器打的太黏糊了 ### 调味"
        },
        {
          "step": 4,
          "description": "每斤肉，6 克盐，1 克胡椒粉"
        },
        {
          "step": 5,
          "description": "上手抓匀"
        },
        {
          "step": 6,
          "description": "葱姜花椒水分次加，边加边搅，用手揉匀，让肉吸饱水。每斤肉末 80 克葱姜花椒水"
        },
        {
